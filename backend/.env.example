# Copy this file to .env and fill in your own values. Every setting has a sensible default
# (see app/config.py); only DATABASE_URL and JWT_SECRET are needed to get started.

# Format: postgresql+psycopg://USER:PASSWORD@HOST:PORT/DATABASE  (postgres:// URLs also work)
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/fleetflow

# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace-with-a-long-random-string
ACCESS_TOKEN_MINUTES=60

# Local time at the depot, used for electricity tariff hours in the charging planner
DEPOT_TIMEZONE=Asia/Karachi

# Optional: switches on the AI dispatch assistant (free key at https://aistudio.google.com)
# GEMINI_API_KEY=

# Optional: send real emails instead of printing them in this terminal (free tier at https://resend.com)
# EMAIL_BACKEND=resend
# RESEND_API_KEY=

# Production only
# ENVIRONMENT=production   # refuses to start with unsafe settings
# DEMO_MODE=true           # protects the shared demo logins from being changed or locked
# CORS_ORIGINS=["https://your-app.vercel.app"]
# FRONTEND_URL=https://your-app.vercel.app
